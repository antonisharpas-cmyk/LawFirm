# Copy this file to .env and fill in the values.

PORT=4000

# Admin console login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
# Long random string used to sign admin sessions
SESSION_SECRET=replace-with-a-long-random-string

# PostgreSQL connection (Render Postgres "Internal Database URL").
# Leave empty to run with an in memory demo database (data resets on restart).
DATABASE_URL=
# Set to false for a local Postgres without SSL
DATABASE_SSL=true

# Public address of the site, used for links in notification emails
PUBLIC_URL=https://ahllc.com.cy

# Email (for example Google Workspace, Microsoft 365 or Amazon SES SMTP). Without SMTP_HOST no emails are sent.
# Sends: office notifications for enquiries, job applications (CV attached) and live chats,
# automatic confirmations to visitors in their language, and chat replies to visitors who left the website.
# The office address is set in Admin > Settings > Emails (NOTIFY_EMAIL below is only a fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=H.A. Andreou & Co Website <info@ahllc.com.cy>
NOTIFY_EMAIL=info@ahllc.com.cy
