# Copy this file to .env and fill in the values.

PORT=4000

# Admin console login (/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password
# Long random string used to sign admin sessions
SESSION_SECRET=replace-with-a-long-random-string

# PostgreSQL connection (Render Postgres "Internal Database URL").
# Leave empty to run with an in memory demo database (data resets on restart).
DATABASE_URL=
# Set to false for a local Postgres without SSL
DATABASE_SSL=true

# Public address of the site, used for links in notification emails
PUBLIC_URL=https://athanasiadoulaw.com

# Optional email notifications for new inquiries and chats (e.g. Amazon SES SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Athanasiadou Law Website <info@athanasiadoulaw.com>
NOTIFY_EMAIL=info@athanasiadoulaw.com
