{
  "name": "ha-andreou-law",
  "version": "1.0.0",
  "private": true,
  "description": "H.A. Andreou & Co website, live chat and admin console",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch-path=server server/index.js",
    "dev:client": "npm --prefix client run dev",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "node server/index.js"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "helmet": "^7.1.0",
    "nodemailer": "^6.9.15",
    "pg": "^8.13.0",
    "pg-mem": "^3.0.2"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
